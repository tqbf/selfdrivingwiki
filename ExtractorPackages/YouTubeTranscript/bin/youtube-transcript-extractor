#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12,<3.14"
# dependencies = [
#     "youtube-transcript-api>=1.0",
# ]
# ///
"""Extractor package entry point for youtube-transcript.

GENERATED by scripts/sync-extractor-packages.sh — do not edit.

The host launches this as `uv run --script <this file>`, so protocol mode
cannot be selected with a trailing flag. This entry point loads the reviewed
`youtube-transcript` script beside it and serves one revision-3 request.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path

# The package directory is an immutable, digest-verified snapshot. Writing
# bytecode beside the script would add an undeclared file and invalidate it.
sys.dont_write_bytecode = True

_SCRIPT = Path(__file__).resolve().parent / "youtube-transcript"
_spec = importlib.util.spec_from_loader(
    "youtube_transcript", importlib.machinery.SourceFileLoader("youtube_transcript", str(_SCRIPT))
)
assert _spec is not None and _spec.loader is not None
_youtube = importlib.util.module_from_spec(_spec)
sys.modules["youtube_transcript"] = _youtube
_spec.loader.exec_module(_youtube)

# Exit hard after the terminal frame is flushed: interpreter shutdown can
# hang joining keep-alive sockets left by the HTTP library, which the host
# would read as a timeout even though the work is complete.
_code = _youtube.run_extractor_protocol(sys.stdin.read())
sys.stdout.flush()
sys.stderr.flush()
os._exit(_code)
