#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12,<3.14"
# dependencies = [
#     "beartype>=0.20",
#     "docling[vlm]>=2.0.0",
#     "spacy>=3.8.14",
#     "en-core-web-sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl",
# ]
# ///
"""pdf2md — Convert a PDF to Markdown using docling + granite-docling VLM.

Usage:
    uv run --script pdf2md input.pdf [--output output.md] [--pipeline vlm|standard] [--json]
    ./pdf2md input.pdf  (if uv is in PATH)

If uv is not installed, download it first:
    mise install

Exit codes:
    0   Success
    1   Unable to parse PDF
    2   PDF contains no extractable text
    3   docling is not available
"""

from __future__ import annotations

import argparse
import contextlib
import json
import re
import sys
from pathlib import Path

from beartype import beartype

# ── docling imports (deferred so --help is instant) ──────────────────────


def _import_docling():
    """Import docling, surfacing a clear error if it is not installed."""
    try:
        from docling.datamodel import vlm_model_specs
        from docling.datamodel.base_models import InputFormat
        from docling.datamodel.pipeline_options import (
            PdfPipelineOptions,
            TableFormerMode,
            VlmPipelineOptions,
        )
        from docling.document_converter import DocumentConverter, PdfFormatOption
        from docling.pipeline.standard_pdf_pipeline import StandardPdfPipeline
        from docling.pipeline.vlm_pipeline import VlmPipeline
        from docling_core.types.doc.labels import DocItemLabel

        return (
            vlm_model_specs,
            InputFormat,
            PdfPipelineOptions,
            TableFormerMode,
            VlmPipelineOptions,
            DocumentConverter,
            PdfFormatOption,
            StandardPdfPipeline,
            VlmPipeline,
            DocItemLabel,
        )
    except ImportError:
        print(
            "Error: docling is not available. Run: uv run --script pdf2md --help",
            file=sys.stderr,
        )
        sys.exit(3)


# ── Text cleanup ─────────────────────────────────────────────────────────

_MULTI_SPACE_RE = re.compile(r"(?m)(?<=\S) {2,}")
_LINE_NUMBER_BLOCK_RE = re.compile(r"^[\d ]+$")
_SOFT_HYPHEN_RE = re.compile(r"­\s*")
_BLOCK_SKIP_PREFIXES = ("#", "```", "    ", "\t", "- ", "* ", "| ", ">")

_nlp = None  # spacy Language, loaded lazily


def _get_nlp():
    global _nlp
    if _nlp is None:
        import spacy

        _nlp = spacy.load("en_core_web_sm", disable=["ner", "lemmatizer"])
    return _nlp


def _is_prose(block: str) -> bool:
    s = block.strip()
    return bool(s) and not any(s.startswith(p) for p in _BLOCK_SKIP_PREFIXES)


def _should_join(b1: str, b2: str, nlp) -> bool:
    """Return True if b2 continues the sentence started in b1."""
    s1 = b1.strip()
    s2 = b2.strip()
    if not s1 or not s2:
        return False
    if s1[-1] in ".!?":
        return False
    combined = s1 + " " + s2
    junction = len(s1) + 1
    doc = nlp(combined)
    for sent in doc.sents:  # noqa: SIM110
        if junction - 2 <= sent.start_char <= junction + 5:
            return False
    return True


def _fix_page_breaks(text: str) -> str:
    """Join paragraphs split by PDF page breaks (spaCy-verified)."""
    nlp = _get_nlp()
    blocks = text.split("\n\n")
    out: list[str] = []
    i = 0
    while i < len(blocks):
        block = blocks[i]
        if (
            _is_prose(block)
            and i + 1 < len(blocks)
            and _is_prose(blocks[i + 1])
            and _should_join(block, blocks[i + 1], nlp)
        ):
            blocks[i + 1] = block.strip() + " " + blocks[i + 1].strip()
            i += 1
            continue
        out.append(block)
        i += 1
    return "\n\n".join(out)


def _clean(text: str) -> str:
    # 1. Strip margin line-number blocks (preprint templates).
    blocks = text.split("\n\n")
    blocks = [b for b in blocks if not _LINE_NUMBER_BLOCK_RE.fullmatch(b.strip())]
    text = "\n\n".join(blocks)

    # 2. Per-line fixes (skip fenced code blocks).
    in_fence = False
    lines = []
    for line in text.split("\n"):
        if line.startswith("```"):
            in_fence = not in_fence
        if not in_fence:
            line = _MULTI_SPACE_RE.sub(" ", line)
            line = _SOFT_HYPHEN_RE.sub("", line)
        lines.append(line)

    # 3. Join paragraphs split by PDF page breaks.
    return _fix_page_breaks("\n".join(lines))


# ── Pipeline construction ────────────────────────────────────────────────


def _build_vlm_converter(
    vlm_model_specs,
    InputFormat,
    VlmPipelineOptions,
    DocumentConverter,
    PdfFormatOption,
    VlmPipeline,
):
    return DocumentConverter(
        format_options={
            InputFormat.PDF: PdfFormatOption(
                pipeline_cls=VlmPipeline,
                pipeline_options=VlmPipelineOptions(
                    vlm_options=vlm_model_specs.GRANITEDOCLING_MLX,
                ),
            ),
        }
    )


def _build_standard_converter(
    InputFormat,
    PdfPipelineOptions,
    TableFormerMode,
    DocumentConverter,
    PdfFormatOption,
    StandardPdfPipeline,
):
    pipeline_options = PdfPipelineOptions()
    pipeline_options.do_ocr = True
    pipeline_options.do_table_structure = True
    pipeline_options.table_structure_options.mode = TableFormerMode.ACCURATE
    return DocumentConverter(
        format_options={
            InputFormat.PDF: PdfFormatOption(
                pipeline_cls=StandardPdfPipeline,
                pipeline_options=pipeline_options,
            ),
        }
    )


# ── Main conversion ──────────────────────────────────────────────────────


@beartype
def convert_pdf(pdf_path: Path, pipeline: str) -> str:
    """Convert a PDF to Markdown.  Raises ValueError on empty output."""
    (
        vlm_model_specs,
        InputFormat,
        PdfPipelineOptions,
        TableFormerMode,
        VlmPipelineOptions,
        DocumentConverter,
        PdfFormatOption,
        StandardPdfPipeline,
        VlmPipeline,
        DocItemLabel,
    ) = _import_docling()

    excluded = {DocItemLabel.FOOTNOTE, DocItemLabel.PAGE_HEADER, DocItemLabel.PAGE_FOOTER}
    included = set(lbl for lbl in DocItemLabel if lbl not in excluded)

    if pipeline == "vlm":
        converter = _build_vlm_converter(
            vlm_model_specs,
            InputFormat,
            VlmPipelineOptions,
            DocumentConverter,
            PdfFormatOption,
            VlmPipeline,
        )
    else:
        converter = _build_standard_converter(
            InputFormat,
            PdfPipelineOptions,
            TableFormerMode,
            DocumentConverter,
            PdfFormatOption,
            StandardPdfPipeline,
        )

    result = converter.convert(pdf_path)
    text = result.document.export_to_markdown(labels=included)
    text = _clean(text)

    if not text.strip():
        raise ValueError("PDF contains no extractable text")

    return text


# ── Extractor protocol mode ──────────────────────────────────────────────
#
# The host runs this script as an extractor package. It writes one JSON
# request on standard input and closes it, then reads JSON Lines frames from
# standard output. Standard output carries protocol frames ONLY; every other
# message goes to standard error.

PROTOCOL_REVISION = 1
PROTOCOL_KIND = "pdf"


def _model_name(pipeline: str) -> str | None:
    """The model the pipeline actually runs, or None when it uses no model."""
    return "granite-docling-mlx" if pipeline == "vlm" else None


@beartype
def build_protocol_frame(kind: str, payload: dict) -> dict:
    """One protocol envelope. The host rejects any other shape."""
    return {"kind": kind, "payload": payload}


def _emit(frame: dict, stream) -> None:
    stream.write(json.dumps(frame, separators=(",", ":")))
    stream.write("\n")
    stream.flush()


@beartype
def _progress(request_id: str, completed: int, total: int, message: str) -> dict:
    return build_protocol_frame(
        "progress",
        {
            "requestID": request_id,
            "completedUnitCount": completed,
            "totalUnitCount": total,
            "message": message,
        },
    )


@beartype
def _failure(request_id: str, cause: str, message: str) -> dict:
    return build_protocol_frame(
        "failure",
        {
            "requestID": request_id,
            "cause": cause,
            "message": message[:4096],
        },
    )


@beartype
def run_extractor_protocol(
    request_text: str,
    out_stream=None,
    log_stream=None,
) -> int:
    """Serve one extractor request.

    Returns the process exit code. A refused or failed request still exits 0
    when a failure frame was emitted, because the frame is the report.
    """
    out_stream = sys.stdout if out_stream is None else out_stream
    log_stream = sys.stderr if log_stream is None else log_stream

    try:
        request = json.loads(request_text)
    except (ValueError, TypeError):
        # No request ID is known, so no frame can be attributed. Exit nonzero
        # and let the host report a malformed protocol.
        print("Error: malformed extractor request", file=log_stream)
        return 2

    request_id = request.get("requestID")
    if not isinstance(request_id, str) or not request_id:
        print("Error: extractor request has no request ID", file=log_stream)
        return 2

    output_path = request.get("outputPath")
    input_path = request.get("inputPath")

    if request.get("protocolRevision") != PROTOCOL_REVISION:
        _emit(_failure(request_id, "invalid-request", "unsupported protocol revision"), out_stream)
        return 0
    if request.get("kind") != PROTOCOL_KIND:
        _emit(
            _failure(request_id, "unsupported-input", "this package extracts PDF only"), out_stream
        )
        return 0
    if not isinstance(input_path, str) or not isinstance(output_path, str):
        _emit(
            _failure(request_id, "invalid-request", "request has no input or output path"),
            out_stream,
        )
        return 0

    source = Path(input_path)
    if not source.exists():
        _emit(_failure(request_id, "invalid-request", "input file is missing"), out_stream)
        return 0

    pipeline = "vlm"
    _emit(_progress(request_id, 0, 2, "preparing"), out_stream)

    try:
        # docling and its model stack write to stdout. Redirect it so the
        # frame stream stays valid JSON Lines.
        with contextlib.redirect_stdout(log_stream):
            text = convert_pdf(source.resolve(), pipeline)
    except ValueError as error:
        _emit(_failure(request_id, "extraction-failure", str(error)), out_stream)
        return 0
    except SystemExit:
        # `_import_docling` exits when docling is absent. Report it as a
        # missing runtime so the host keeps its reviewed fallback.
        _emit(_failure(request_id, "missing-runtime", "docling is not available"), out_stream)
        return 0
    except Exception as error:  # noqa: BLE001 - reported as a typed frame
        _emit(
            _failure(request_id, "extraction-failure", f"unable to parse PDF: {error}"), out_stream
        )
        return 0

    _emit(_progress(request_id, 1, 2, "writing markdown"), out_stream)

    try:
        destination = Path(output_path)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(text, encoding="utf-8")
    except OSError as error:
        _emit(
            _failure(request_id, "extraction-failure", f"unable to write markdown: {error}"),
            out_stream,
        )
        return 0

    metadata = {"toolName": "pdf2md"}
    model = _model_name(pipeline)
    if model is not None:
        metadata["modelName"] = model

    _emit(
        build_protocol_frame(
            "result",
            {
                "requestID": request_id,
                "outputPath": output_path,
                "markdownByteCount": len(text.encode("utf-8")),
                "metadata": metadata,
            },
        ),
        out_stream,
    )
    return 0


# ── CLI ──────────────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    """Build the argument parser (extracted for testability)."""
    parser = argparse.ArgumentParser(
        description="Convert a PDF to Markdown using docling + granite-docling."
    )
    parser.add_argument("input", type=Path, nargs="?", help="Path to the PDF file")
    parser.add_argument(
        "--extractor-protocol",
        action="store_true",
        help="Serve one extractor protocol request on stdin/stdout (host use)",
    )
    parser.add_argument(
        "--output",
        "-o",
        type=Path,
        default=None,
        help="Write markdown to file (default: stdout)",
    )
    parser.add_argument(
        "--pipeline",
        choices=("vlm", "standard"),
        default="vlm",
        help="Pipeline: vlm (GRANITEDOCLING_MLX, best quality) or standard (faster)",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output JSON with metadata instead of raw markdown",
    )
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.extractor_protocol:
        # The host writes one request and closes standard input.
        sys.exit(run_extractor_protocol(sys.stdin.read()))

    if args.input is None:
        parser.error("the following arguments are required: input")

    if not args.input.exists():
        print(f"Error: file not found: {args.input}", file=sys.stderr)
        sys.exit(1)

    try:
        text = convert_pdf(args.input.resolve(), args.pipeline)
    except ValueError as e:
        msg = str(e)
        if args.json:
            json.dump({"error": msg, "input": str(args.input)}, sys.stdout)
        else:
            print(f"Error: {msg}", file=sys.stderr)
        sys.exit(2)
    except Exception as e:
        msg = f"Unable to parse PDF: {e}"
        if args.json:
            json.dump({"error": msg, "input": str(args.input)}, sys.stdout)
        else:
            print(f"Error: {msg}", file=sys.stderr)
        sys.exit(1)

    if args.json:
        json.dump(
            {
                "input": str(args.input),
                "pipeline": args.pipeline,
                "char_count": len(text),
                "line_count": text.count("\n") + 1,
            },
            sys.stdout,
        )
        sys.stdout.write("\n")
    elif args.output:
        args.output.write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
