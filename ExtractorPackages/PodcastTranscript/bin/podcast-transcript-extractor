"""Extractor package entry point for podcast-transcript.

GENERATED by scripts/sync-extractor-packages.sh — do not edit.

The host launches this as `uv run --script <this file>`, so protocol mode
cannot be selected with a trailing flag. This entry point loads the reviewed
`podcast-transcript` script beside it and serves one revision-3 request.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
from pathlib import Path

# The package directory is an immutable, digest-verified snapshot. Writing
# bytecode beside the script would add an undeclared file and invalidate it.
sys.dont_write_bytecode = True

_SCRIPT = Path(__file__).resolve().parent / "podcast-transcript"
_spec = importlib.util.spec_from_loader(
    "podcast_transcript", importlib.machinery.SourceFileLoader("podcast_transcript", str(_SCRIPT))
)
assert _spec is not None and _spec.loader is not None
_podcast = importlib.util.module_from_spec(_spec)
sys.modules["podcast_transcript"] = _podcast
_spec.loader.exec_module(_podcast)

sys.exit(_podcast.run_extractor_protocol(sys.stdin.read()))
