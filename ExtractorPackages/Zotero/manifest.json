{
  "capabilities": [
    "network",
    "shared-runtime-cache"
  ],
  "displayName": "Zotero Attachment",
  "entryPoint": "bin/zotero-extractor",
  "files": [
    {
      "digest": "4a1c89cdc6ce6e8b0f6d4f4e5d767318503765233da048dd533a8984ae9c092a",
      "path": "PROVENANCE.md"
    },
    {
      "digest": "06b9bb3af673a6c17b74e9a6ce7315e9bba21baff3204684b6a1c6d4e397d482",
      "path": "bin/zotero"
    },
    {
      "digest": "c9192e2493074138e86bede9cb8f4db57d0a60d02a1f7bc3cf701f72aeadf508",
      "path": "bin/zotero-extractor"
    }
  ],
  "launch": {
    "arguments": [
      "run",
      "--script"
    ],
    "command": "uv",
    "mode": "runtime"
  },
  "limits": {
    "maximumDurationMilliseconds": 600000,
    "maximumInputByteCount": 1048576,
    "maximumMarkdownOutputByteCount": 134217728,
    "maximumProgressEventCount": 64
  },
  "manifestRevision": 4,
  "packageID": "org.selfdrivingwiki.zotero",
  "protocolRevision": 5,
  "registrations": [
    {
      "credentialRequirements": [
        {
          "id": "zotero-api-key",
          "kind": "secret",
          "label": "Zotero API Key",
          "optional": false,
          "purpose": "Read your Zotero library and download attachment files."
        }
      ],
      "displayName": "Zotero Attachment",
      "id": "attachment",
      "mimeTypes": [
        "application/zotero"
      ],
      "role": "fetcher",
      "sync": {
        "configFileName": "zotero-config.json",
        "fields": [
          {
            "name": "libraryID",
            "required": true
          },
          {
            "isList": true,
            "name": "attachments",
            "required": true
          }
        ],
        "itemValidation": {
          "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
          "maximumLength": 8,
          "minimumLength": 8
        },
        "sourceMIMEType": "application/zotero",
        "urlTemplate": "https://api.zotero.org/users/{libraryID}/items/{itemKey}/file"
      }
    }
  ],
  "version": "1.1.0"
}
