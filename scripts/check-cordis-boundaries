#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ $# -gt 1 || (${1:-} != "" && ${1:-} != "--strict") ]]; then
  echo "usage: scripts/check-cordis-boundaries [--strict]" >&2
  exit 2
fi

failed=0
source_root="${CORDIS_BOUNDARY_SOURCE_ROOT:-Sources}"
policy_prefix="${CORDIS_BOUNDARY_POLICY_PREFIX-Sources}"

reject_matches() {
  local label="$1"
  local pattern="$2"
  shift 2
  local matches
  matches="$({ grep -RIlE --include='*.swift' "$pattern" "$source_root" || true; } | while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local relative_path="${path#"$source_root"/}"
    local policy_path="$relative_path"
    if [[ -n "$policy_prefix" ]]; then
      policy_path="$policy_prefix/$relative_path"
    fi
    local allowed=0
    for prefix in "$@"; do
      [[ "$policy_path" == "$prefix" ]] && allowed=1 && break
    done
    if [[ $allowed -eq 0 ]]; then
      printf '%s\n' "$policy_path"
    fi
  done | LC_ALL=C sort)"
  if [[ -n "$matches" ]]; then
    echo "Cordis boundary violation: $label:" >&2
    printf '%s\n' "$matches" >&2
    return 1
  fi
  return 0
}

reject_matches "RuntimeAssembly remains in Sources/" 'RuntimeAssembly' || failed=1
reject_matches "untyped Cordis service key" 'ServiceKey<[^>]*any[[:space:]]+Sendable' || failed=1
reject_matches "Cordis service key contains an application or context type" \
  'ServiceKey<[^>]*(WikiStoreModel|SearchCompositionOwner|AgentLauncher|GenerationGate|PerWikiRuntimeServices|BootedProfile|CordisContext)' || failed=1
# StoreBackend and WikiRegistryClient are named pre-profile construction boundaries.
# SessionManager and ProfileWikiSession retain explicit test-fixture factories.
# SessionsPlugin provisions the session-owned model factory.
# StorePlugin resolves the named StoreBackend factory during activation.
# The wikictl-fixture store profile is the fixture binary's named backend
# boundary (its entire job is booting one explicit fixture database).
reject_matches "makeStore remains outside a named bootstrap, backend, fallback, or test boundary" \
  '(^|[^[:alnum:]_])makeStore([^[:alnum:]_]|$)' \
  Sources/wikictl-fixture/FixtureStoreProfile.swift \
  Sources/WikiFSCore/Core/WikiRegistryClient.swift \
  Sources/WikiFSCore/Store/StoreBackend.swift \
  Sources/WikiFSEngine/ProfileWikiSession.swift \
  Sources/WikiFSEngine/SessionManager.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift \
  Sources/WikiFSEngine/StorePlugin.swift \
  Sources/wikid/LintEvalDriverHost.swift || failed=1
reject_matches "public production facade exposes BootedProfile or CordisContext" \
  'public[[:space:]]+(let|var|typealias|func|init)[^\n]*(BootedProfile|CordisContext)' \
  Sources/Cordis/CordisContext.swift \
  Sources/CordisLoader/EntryTree.swift \
  Sources/wikictl-fixture/FixtureStoreProfile.swift \
  Sources/WikiFSEngine/ProductionPluginCatalogs.swift \
  Sources/WikiFSEngine/SearchRuntimeCompositionFactory.swift \
  Sources/WikiFSEngine/SearchRuntimeFactory.swift || failed=1
reject_matches "session facade is constructed outside its boot/factory boundary" \
  '(^|[^[:alnum:]_])(WikiSession|ProfileWikiSession)\(' \
  Sources/WikiFSEngine/ProductionPluginCatalogs.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# TransclusionEmbedder documents its read-only projection store boundary.
# WikiRegistryClient documents its injected pre-profile bootstrap factory.
# GRDBWikiStore documents its own concrete initializer contract.
# StoreBackend is the named concrete-backend construction boundary.
# WikiReadService owns its private read-only pooled connections.
# ProfileWikiSession documents its synchronous test-fixture boundary.
# Projection is a separate extension process with query-only stores.
# wikid/main.swift retains the Linux stdio compatibility fixture factory.
# wikid/LintEvalDriverHost.swift is the live gate's daemon host: the eval
# driver engine receives store/model/launcher constructions ONLY through
# the LintLiveGateFactories this host fills (the disposable eval substrate).
reject_matches "GRDBWikiStore is constructed outside a store plugin/factory" \
  '(^|[^[:alnum:]_])GRDBWikiStore\(' \
  Sources/WikiFS/Reader/TransclusionEmbedder.swift \
  Sources/WikiFSCore/Core/WikiRegistryClient.swift \
  Sources/WikiFSCore/Store/GRDBWikiStore.swift \
  Sources/WikiFSCore/Store/StoreBackend.swift \
  Sources/WikiFSCore/Store/WikiReadService.swift \
  Sources/WikiFSEngine/ProfileWikiSession.swift \
  Sources/WikiFSFileProvider/Projection.swift \
  Sources/wikid/LintEvalDriverHost.swift \
  Sources/wikid/main.swift || failed=1
reject_matches "WikiStoreModel is constructed outside a plugin/factory" \
  '(^|[^[:alnum:]_])WikiStoreModel\(' \
  Sources/WikiFSCore/Core/WikiRegistryClient.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift \
  Sources/wikid/LintEvalDriverHost.swift || failed=1
reject_matches "search composition is constructed outside a plugin/factory" \
  '(^|[^[:alnum:]_])SearchCompositionOwner\(' \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# RendererCompositionOwner is an intentional app UI-shell adapter.
# AgentLauncher owns its default gate convenience initializer.
# GenerationGate owns its concrete admission implementation.
# SessionsPlugin provisions per-wiki launcher factories and test fixtures.
reject_matches "GenerationGate is constructed outside a plugin/factory or its own facade" \
  '(^|[^[:alnum:]_])GenerationGate\(' \
  Sources/WikiFS/Renderer/RendererCompositionOwner.swift \
  Sources/WikiFSEngine/AgentLauncher.swift \
  Sources/WikiFSEngine/GenerationGate.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# RendererCompositionOwner is an intentional app UI-shell adapter.
# AgentLauncher owns its concrete launcher implementation.
# SessionsPlugin provisions per-wiki launcher factories and test fixtures.
# wikid/LintEvalDriverHost.swift is the live gate's daemon host; the driver
# engine receives launchers ONLY through its injected factory.
reject_matches "AgentLauncher is constructed outside a plugin/factory or launcher facade" \
  '(^|[^[:alnum:]_])AgentLauncher\(' \
  Sources/WikiFS/Renderer/RendererCompositionOwner.swift \
  Sources/WikiFSEngine/AgentLauncher.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift \
  Sources/wikid/LintEvalDriverHost.swift || failed=1

# Scope-limited variant of reject_matches: the pattern is grepped under
# "$source_root/<scope>" only. A missing scope directory (synthetic fixture
# roots in the boundary tests) is not an error — it simply has no matches, and
# the fixture layout (<root>/Sources/<scope>) falls back to the nested path so
# synthetic fixtures resolve exactly like the real tree.
reject_matches_in() {
  local label="$1"
  local scope="$2"
  local pattern="$3"
  shift 3
  local scope_dir="$source_root/$scope"
  [[ -d "$scope_dir" ]] || scope_dir="$source_root/Sources/$scope"
  local matches
  matches="$({ grep -RIlE --include='*.swift' "$pattern" "$scope_dir" 2>/dev/null || true; } | while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local relative_path="${path#"$source_root/"}"
    local policy_path="$relative_path"
    if [[ -n "$policy_prefix" ]]; then
      policy_path="$policy_prefix/$relative_path"
    fi
    local allowed=0
    for prefix in "$@"; do
      [[ "$policy_path" == "$prefix" ]] && allowed=1 && break
    done
    if [[ $allowed -eq 0 ]]; then
      printf '%s\n' "$policy_path"
    fi
  done | LC_ALL=C sort)"
  if [[ -n "$matches" ]]; then
    echo "Cordis boundary violation: $label:" >&2
    printf '%s\n' "$matches" >&2
    return 1
  fi
  return 0
}

# The fixture-binary split of plans/cli-domain-commands.md (§"The fixture
# binary") — one pathway, enforced: the CLI targets (wikictl + WikiCtlCore)
# reach wiki data ONLY through the daemon over the domain envelope. The queue
# store is opened by wikid and the app's queue engine; the registry is loaded
# by wikid, the app shell, and WikiRegistryClient (the pre-profile bootstrap
# boundary). Disposable --database-path fixture runs use the SEPARATE
# build-only `wikictl-fixture` executable target (Sources/wikictl-fixture),
# which — like the test targets — is outside these CLI scopes: its local store
# boot and its direct QueueStore write are its entire reason to exist, and the
# rules below fail if any of that machinery regresses into WikiCtlCore or
# wikictl.
reject_matches_in \
  "QueueStore is constructed in a CLI target (registry-selected runs ride the daemon; fixture runs use the wikictl-fixture binary)" \
  "WikiCtlCore" '(^|[^[:alnum:]_])QueueStore\(' || failed=1
reject_matches_in \
  "QueueStore is constructed in a CLI target (registry-selected runs ride the daemon; fixture runs use the wikictl-fixture binary)" \
  "wikictl" '(^|[^[:alnum:]_])QueueStore\(' || failed=1
reject_matches_in \
  "GRDBWikiStore is constructed in a CLI target (the daemon and the wikictl-fixture store profile own store construction)" \
  "WikiCtlCore" '(^|[^[:alnum:]_])GRDBWikiStore\(' || failed=1
reject_matches_in \
  "GRDBWikiStore is constructed in a CLI target (the daemon and the wikictl-fixture store profile own store construction)" \
  "wikictl" '(^|[^[:alnum:]_])GRDBWikiStore\(' || failed=1
reject_matches_in \
  "WikiRegistry is loaded in a CLI target (--wiki resolves through the daemon's resolveWiki over the socket)" \
  "WikiCtlCore" '(^|[^[:alnum:]_])WikiRegistry\.load\(' || failed=1
reject_matches_in \
  "WikiRegistry is loaded in a CLI target (--wiki resolves through the daemon's resolveWiki over the socket)" \
  "wikictl" '(^|[^[:alnum:]_])WikiRegistry\.load\(' || failed=1

process_catalog="$source_root/WikiFSEngine/ProductionPluginCatalogs.swift"
if [[ -f "$process_catalog" ]]; then
  required_process_markers=(
    'ServiceKey<ProcessCompositionInputs>'
    'dependencies: [ServiceDependency(ProcessServiceKeys.compositionInputs)]'
    'activation.require(ProcessServiceKeys.compositionInputs)'
  )
  for marker in "${required_process_markers[@]}"; do
    if ! grep -Fq "$marker" "$process_catalog"; then
      echo "Cordis boundary violation: process plugins hide stable dependencies: $marker" >&2
      failed=1
    fi
  done
fi

if [[ $failed -ne 0 ]]; then
  exit 1
fi

echo "Cordis boundaries verified."
