#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ $# -gt 1 || (${1:-} != "" && ${1:-} != "--strict") ]]; then
  echo "usage: scripts/check-cordis-boundaries [--strict]" >&2
  exit 2
fi

failed=0
source_root="${CORDIS_BOUNDARY_SOURCE_ROOT:-Sources}"
policy_prefix="${CORDIS_BOUNDARY_POLICY_PREFIX-Sources}"

reject_matches() {
  local label="$1"
  local pattern="$2"
  shift 2
  local matches
  matches="$({ grep -RIlE --include='*.swift' "$pattern" "$source_root" || true; } | while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local relative_path="${path#"$source_root"/}"
    local policy_path="$relative_path"
    if [[ -n "$policy_prefix" ]]; then
      policy_path="$policy_prefix/$relative_path"
    fi
    local allowed=0
    for prefix in "$@"; do
      [[ "$policy_path" == "$prefix" ]] && allowed=1 && break
    done
    if [[ $allowed -eq 0 ]]; then
      printf '%s\n' "$policy_path"
    fi
  done | LC_ALL=C sort)"
  if [[ -n "$matches" ]]; then
    echo "Cordis boundary violation: $label:" >&2
    printf '%s\n' "$matches" >&2
    return 1
  fi
  return 0
}

reject_matches "RuntimeAssembly remains in Sources/" 'RuntimeAssembly' || failed=1
reject_matches "session facade is constructed outside its boot/factory boundary" \
  '(^|[^[:alnum:]_])(WikiSession|ProfileWikiSession)\(' \
  Sources/WikiFSEngine/ProductionPluginCatalogs.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# TransclusionEmbedder documents its read-only projection store boundary.
# WikiRegistryClient documents its injected pre-profile bootstrap factory.
# GRDBWikiStore documents its own concrete initializer contract.
# StoreBackend is the named concrete-backend construction boundary.
# WikiReadPool owns read-only pooled connections.
# ProfileWikiSession documents its synchronous test-fixture boundary.
# Projection is a separate extension process with query-only stores.
# wikid/main.swift retains the Linux stdio compatibility fixture factory.
reject_matches "GRDBWikiStore is constructed outside a store plugin/factory" \
  '(^|[^[:alnum:]_])GRDBWikiStore\(' \
  Sources/WikiFS/Reader/TransclusionEmbedder.swift \
  Sources/WikiFSCore/Core/WikiRegistryClient.swift \
  Sources/WikiFSCore/Store/GRDBWikiStore.swift \
  Sources/WikiFSCore/Store/StoreBackend.swift \
  Sources/WikiFSCore/Store/WikiReadPool.swift \
  Sources/WikiFSEngine/ProfileWikiSession.swift \
  Sources/WikiFSFileProvider/Projection.swift \
  Sources/wikid/main.swift || failed=1
reject_matches "WikiStoreModel is constructed outside a plugin/factory" \
  '(^|[^[:alnum:]_])WikiStoreModel\(' \
  Sources/WikiFSCore/Core/WikiRegistryClient.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
reject_matches "search composition is constructed outside a plugin/factory" \
  '(^|[^[:alnum:]_])SearchCompositionOwner\(' \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# RendererCompositionOwner is an intentional app UI-shell adapter.
# AgentLauncher owns its default gate convenience initializer.
# GenerationGate owns its concrete admission implementation.
# SessionsPlugin provisions per-wiki launcher factories and test fixtures.
reject_matches "GenerationGate is constructed outside a plugin/factory or its own facade" \
  '(^|[^[:alnum:]_])GenerationGate\(' \
  Sources/WikiFS/Renderer/RendererCompositionOwner.swift \
  Sources/WikiFSEngine/AgentLauncher.swift \
  Sources/WikiFSEngine/GenerationGate.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1
# RendererCompositionOwner is an intentional app UI-shell adapter.
# AgentLauncher owns its concrete launcher implementation.
# SessionsPlugin provisions per-wiki launcher factories and test fixtures.
reject_matches "AgentLauncher is constructed outside a plugin/factory or launcher facade" \
  '(^|[^[:alnum:]_])AgentLauncher\(' \
  Sources/WikiFS/Renderer/RendererCompositionOwner.swift \
  Sources/WikiFSEngine/AgentLauncher.swift \
  Sources/WikiFSEngine/SessionsPlugin.swift || failed=1

if [[ $failed -ne 0 ]]; then
  exit 1
fi

echo "Cordis boundaries verified."
